skinparam ClassHeaderBackgroundColor #dfe8f7
skinparam PackageBorderColor #8a9bb8
skinparam PackageBackgroundColor #fbfcfe
skinparam NoteBackgroundColor #fff8dc
skinparam NoteBorderColor #c9b458
skinparam EntityBorderColor #3b5b92
skinparam EntityBackgroundColor #f4f7fc
